(defcfg
    process-unmapped-keys yes
    danger-enable-cmd no
    log-layer-changes no)

(defsrc)

;;(deflayermap (base-layer)
;;    left (fork left (unmod home) (lalt))
;;    right (fork right (unmod end) (lalt))
;;    up (fork up (unmod pgup) (lalt))
;;    down (fork down (unmod pgdn) (lalt)))

(deflayermap (base-layer)
    lalt (tap-hold 200 200 lalt (layer-while-held alted-layer)))

(deflayermap (alted-layer)
    ___ (multi lalt _)
    left home
    right end
    up pgup
    down pgdn)
